{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build BOJ",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/BOJ/BOJ.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "run BOJ (select problem, input.txt -> output.txt)",
      "type": "process",
      "command": "cmd",
      "args": [
        "/c",
        "dotnet run --no-launch-profile --project \"${workspaceFolder}\\BOJ\\BOJ.csproj\" --no-build -- ${input:bojProblem} < \"${workspaceFolder}\\BOJ\\input.txt\" > \"${workspaceFolder}\\BOJ\\output.txt\""
      ],
      "dependsOn": "build BOJ",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "bojProblem",
      "type": "promptString",
      "description": "Problem number (e.g. 6696)",
      "default": "6696"
    }
  ]
}
